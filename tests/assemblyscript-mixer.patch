+        return Reflect.get(target, aliases.get(property), target);
+      }
+      return Reflect.get(target, property, receiver);
+    },
+    has(target, property) {
+      return (typeof property === "string" && aliases.has(property)) || Reflect.has(target, property);
+    }
+  });
+}
