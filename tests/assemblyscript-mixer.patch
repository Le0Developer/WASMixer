+}
+
+function aliasImportNames(imports, originalImports, mixedImports) {
+  for (let i = 0; i < originalImports.length; ++i) {
+    const original = originalImports[i];
+    const mixed = mixedImports[i];
+    if (original.module === mixed.module && original.name === mixed.name) continue;
+    const originalModule = imports[original.module];
