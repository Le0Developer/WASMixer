+    const mixedModule = new WebAssembly.Module(mixedBuffer);
+    const mixedImports = WebAssembly.Module.imports(mixedModule);
+    const mixedExports = WebAssembly.Module.exports(mixedModule);
+    if (originalImports.length !== mixedImports.length || originalExports.length !== mixedExports.length) {
+      throw new Error("WASMixer changed the number of imports or exports");
+    }
